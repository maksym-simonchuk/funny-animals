# Copy to .env and fill in real values. Never commit .env.
PEXELS_API_KEY=
PIXABAY_API_KEY=
# Shared secret between the browser extension and the local queue endpoint.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
BROWSER_INGEST_TOKEN=
# Overrides storage.database from config.yaml — leave unset for local sqlite.
